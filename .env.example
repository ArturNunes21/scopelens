# Copy to .env.local and fill in. None of these variables exist yet —
# they depend on accounts being created in each service (see ROADMAP.md Phase 0 / SETUP.md).

# Sentry — https://sentry.io (new project, Next.js platform)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog — https://posthog.com (new project)
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase — https://supabase.com (new project), see ARCHITECTURE.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build the magic-link redirect (src/app/login/actions.ts).
# Local dev default is http://localhost:3000; set to the Vercel URL in production.
NEXT_PUBLIC_SITE_URL=

# Anthropic (Claude API) — https://console.anthropic.com, see PRD.md section 8.3/10
ANTHROPIC_API_KEY=
# Monthly AI cost ceiling per workspace, in USD (ARCHITECTURE.md 2.5, GAPS.md G12). Optional — defaults to 5.
AI_MONTHLY_BUDGET_USD=5

# Stripe (test mode) — https://dashboard.stripe.com, see PRD.md section 10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price ID (test mode) for the Pro subscription — Dashboard → Product catalog.
STRIPE_PRICE_ID_PRO=
# Meetings/month allowed on the free plan before the Phase 7 feature gate
# blocks new ones (ARCHITECTURE.md section 3 "Billing"). Optional — defaults to 5.
FREE_PLAN_MEETING_LIMIT=5
