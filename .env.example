# Copie para .env.local e preencha. Nenhuma dessas variáveis existe ainda —
# dependem de contas a serem criadas nos respectivos serviços (ver ROADMAP.md Fase 0).

# Sentry — https://sentry.io (projeto novo, tipo Next.js)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog — https://posthog.com (projeto novo)
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase — https://supabase.com (projeto novo), ver ARCHITECTURE.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude API) — https://console.anthropic.com, ver PRD.md seção 8.3/10
ANTHROPIC_API_KEY=

# Stripe (test mode) — https://dashboard.stripe.com, ver PRD.md seção 10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
